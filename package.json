{
    "name": "@datagrout/n8n-nodes-datagrout",
    "version": "1.0.0",
    "description": "Ask questions of your connected business data from n8n workflows and AI Agents, and get verified answers",
    "license": "MIT",
    "homepage": "https://github.com/DataGrout/n8n-node",
    "keywords": [
        "n8n-community-node-package",
        "datagrout",
        "ai",
        "business-data"
    ],
    "author": {
        "name": "DataGrout",
        "email": "support@datagrout.ai"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DataGrout/n8n-node.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "prepublishOnly": "npm test && npm run build && npm run lint",
        "test": "node --test --experimental-strip-types test/*.test.ts"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": false,
        "credentials": [
            "dist/credentials/DataGroutApi.credentials.js",
            "dist/credentials/DataGroutOAuth2Api.credentials.js"
        ],
        "nodes": [
            "dist/nodes/DataGrout/DataGrout.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "^0.37.3",
        "@types/node": "^26.1.2",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}